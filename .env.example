# ==== NounStudyHub environment variables ====
# Copy this file to .env (local) or set these in Render's Dashboard > Environment.

# MongoDB connection string (REQUIRED - MongoDB Atlas or local MongoDB)
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nounstudyhub
MONGODB_URI=mongodb://127.0.0.1:27017/nounstudyhub

# Admin console credentials (REQUIRED on production)
# ADMIN_USERNAME can be plain text; ADMIN_PASSWORD can be plain text OR a bcrypt hash.
ADMIN_USERNAME=Khalifa
ADMIN_PASSWORD=Khalifa1

# Google Gemini AI (server-side only; never prefix this key with NEXT_PUBLIC_)
# GEMINI_API_KEY=your-google-gemini-key
# AI_DAILY_LIMIT=100
